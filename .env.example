# ========================================================
# 1. CẤU HÌNH BẢO MẬT ADMIN & VERCEL AUTH
# ========================================================
ADMIN_PASSWORD=gradinvite2026
AUTH_SECRET=change-me-to-a-long-random-secret

# ========================================================
# 2. CẤU HÌNH FIREBASE FIRESTORE (BẮT BUỘC KHI HOST VERCEL)
# ========================================================
# Cách 1 (Khuyên dùng trên Vercel): Dán nguyên JSON của Service Account (hoặc Base64)
FIREBASE_SERVICE_ACCOUNT=
# Tùy chọn: Chỉ điền nếu anh tạo Firestore Database với tên khác "(default)"
# FIREBASE_DATABASE_ID=(default)

# Cách 2: Điền rời 3 biến (nếu không dùng FIREBASE_SERVICE_ACCOUNT)
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ========================================================
# 3. CẤU HÌNH GỬI EMAIL DOANH NGHIỆP ALIBABA CLOUD (qiye.aliyun)
# ========================================================

# Máy chủ SMTP của Aliyun Enterprise Mail (Mặc định: smtp.qiye.aliyun.com)
ALIYUN_SMTP_HOST=smtp.qiye.aliyun.com

# Cổng SMTP: 465 (Khuyến nghị dùng SSL) hoặc 587/25
ALIYUN_SMTP_PORT=465

# Tài khoản email doanh nghiệp Aliyun đầy đủ (Ví dụ: yourname@yourdomain.com)
ALIYUN_MAIL_USER=your_email@yourdomain.com

# Mật khẩu email hoặc App Password (Mã ủy quyền ứng dụng)
ALIYUN_MAIL_PASS=your_email_password

# Tên hiển thị người gửi
ALIYUN_FROM_NAME=Nguyễn Đình Tuấn - Lễ Tốt Nghiệp 2026

